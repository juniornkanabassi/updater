<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SpawnConstraint cannot use build-setting substitution: team-identifier must match DEVELOPMENT_TEAM (M6L2VW4W5Z). build.sh checks it. -->
<plist version="1.0">
<dict>
	<key>SpawnConstraint</key>
	<dict>
		<key>team-identifier</key>
		<string>M6L2VW4W5Z</string>
		<key>signing-identifier</key>
		<string>com.juniornkanabassi.Updater.helper</string>
	</dict>
	<key>BundleProgram</key>
	<string>Contents/Resources/UpdaterInstaller</string>
	<key>Label</key>
	<string>com.juniornkanabassi.Updater.helper.daemon</string>
	<key>MachServices</key>
	<dict>
		<key>com.juniornkanabassi.Updater.helper</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
